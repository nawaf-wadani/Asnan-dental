# Copy to `.env` for local dev (never commit `.env`). In production these are set
# as Netlify environment variables (Site settings -> Environment variables).

# --- Auth -------------------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate: `openssl rand -base64 48`
AUTH_SECRET=

# Bootstrap admin. On the first successful login with these exact credentials
# (and no matching user row yet) the admin account is created, after which
# these vars are only a fallback. Change the password from the admin panel
# after first login.
ADMIN_EMAIL=Nawaf@asnandental.ca
ADMIN_PASSWORD=

# Session lifetime in hours (sliding is not used; hard expiry).
SESSION_HOURS=12

# --- Order email (Google Workspace SMTP) ----------------------------------
# Create an App Password on the sending Google account (requires 2-Step
# Verification): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=Orders@asnandental.ca
SMTP_PASS=
SMTP_FROM=Asnan Dental Orders <Orders@asnandental.ca>

# Comma-separated recipients that every placed order is emailed to.
ORDER_EMAIL_TO=Nawaf@asnandental.ca,Orders@asnandental.ca
# When "true", also CC the assistant who placed the order (uses their account email).
ORDER_EMAIL_CC_ASSISTANT=true

# --- App -----------------------------------------------------------------
# Public origin, used in email links. e.g. https://asnan-orders.netlify.app
APP_ORIGIN=
